# Keep the image build context to what `go build ./cmd/...` needs.
# Both images/*/Dockerfile COPY the repo root; without this the
# context ships .git, the docs site, and the legacy opentelemetry
# module on every build (#156).
.git
.github
.claude
docs
dev
k8s
tests
opentelemetry
*.md
