# Two-stage build for the v0.4 control-plane binary. Same shape as
# images/ollie/Dockerfile: golang builder → distroless static. CGO
# off; the resulting binary is fully static so the final image
# needs no libc.

ARG VERSION=v0.4.0-dev

FROM golang:1.27.4@sha256:5e8afd493a7124a8586e134d9b532731161d4b9becf9dee5a5956b107426f93d AS builder
ARG VERSION
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/ollie-controller \
    ./cmd/ollie-controller

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=builder /out/ollie-controller /ollie-controller
USER 65532:65532
ENTRYPOINT ["/ollie-controller"]
