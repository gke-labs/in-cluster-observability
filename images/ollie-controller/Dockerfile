# Two-stage build for the v0.4 control-plane binary. Same shape as
# images/ollie/Dockerfile: golang builder → distroless static. CGO
# off; the resulting binary is fully static so the final image
# needs no libc.

ARG VERSION=v0.4.0-dev

FROM golang:1.26@sha256:3aff6657219a4d9c14e27fb1d8976c49c29fddb70ba835014f477e1c70636647 AS builder
ARG VERSION
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/ollie-controller \
    ./cmd/ollie-controller

FROM gcr.io/distroless/static-debian12:nonroot@sha256:f5b485ea962d9bd1186b2f6b3a061191539b905b82ec395de78cbfae51f20e35
COPY --from=builder /out/ollie-controller /ollie-controller
USER 65532:65532
ENTRYPOINT ["/ollie-controller"]
